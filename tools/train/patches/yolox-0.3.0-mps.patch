     def __init__(self, loader):
         self.loader = iter(loader)
-        self.stream = torch.cuda.Stream()
-        self.input_cuda = self._input_cuda_for_image
-        self.record_stream = DataPrefetcher._record_stream_for_image
+        # CyberSend MPS patch: original code unconditionally created a CUDA side
+        # stream and moved batches with .cuda(). Branch on CUDA availability and
+        # move batches directly to MPS (or keep them on CPU) otherwise.
+        # See tools/train/patches/yolox-0.3.0-mps.patch.
+        if torch.cuda.is_available():
+            self.stream = torch.cuda.Stream()
+            self.input_cuda = self._input_cuda_for_image
+            self.record_stream = DataPrefetcher._record_stream_for_image
