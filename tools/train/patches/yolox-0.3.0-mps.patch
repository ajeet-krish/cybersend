# CyberSend MPS device patch for yolox 0.3.0 (PyPI, Megvii, Apache-2.0).
#
# Generated 2026-10-20 against the pristine yolox 0.3.0 sdist; applies to
# the installed package under .venv-yolox/lib/python3.12/site-packages/yolox/.
# Seven training-path files change; every change branches on
# torch.cuda.is_available() or replaces a legacy .type(str) cast with the
# source tensor's own dtype/device, so CUDA behavior stays identical:
#
#   core/trainer.py         device selection (cuda:N -> mps) and guarded set_device
#   data/data_prefetcher.py no CUDA side stream on non-CUDA hosts; batches go to mps
#   exp/yolox_base.py       random_resize CPU tensor instead of torch.LongTensor(2).cuda()
#   evaluators/coco_evaluator.py  imgs/statistics on the model device, not CUDA types
#   models/yolo_head.py     grid casts via output dtype/device (legacy .type(str)
#                           raises ValueError on MPS type strings); affects both
#                           the training grid and eval decode_outputs
#   models/losses.py        IOUloss mask cast via tl.dtype (runs every iteration)
#   utils/boxes.py          bboxes_iou mask cast via tl.dtype (SimOTA matching
#                           every iteration plus eval)
#
# Verified on torch 2.14.1/macOS arm64 (MPS): Trainer construction, prefetcher,
# random_resize, eval forward, and train forward+backward through SimOTA.
#
# Out of scope (untouched, never on this run path): the torch2trt branch
# (trt_file is always None here) and distributed/NCCL paths (single process).
#
# Apply from site-packages after install:
#   patch -p1 < tools/train/patches/yolox-0.3.0-mps.patch

--- a/yolox/core/trainer.py
+++ b/yolox/core/trainer.py
@@ -47,7 +47,12 @@
         self.is_distributed = get_world_size() > 1
         self.rank = get_rank()
         self.local_rank = get_local_rank()
-        self.device = "cuda:{}".format(self.local_rank)
+        if torch.cuda.is_available():
+            self.device = "cuda:{}".format(self.local_rank)
+        else:
+            # CyberSend MPS patch: no CUDA on Apple Silicon; use MPS when built,
+            # otherwise CPU. See tools/train/patches/yolox-0.3.0-mps.patch.
+            self.device = "mps" if torch.backends.mps.is_available() else "cpu"
         self.use_model_ema = exp.ema
         self.save_history_ckpt = exp.save_history_ckpt
 
@@ -131,7 +136,8 @@
         logger.info("exp value:\n{}".format(self.exp))
 
         # model related init
-        torch.cuda.set_device(self.local_rank)
+        if torch.cuda.is_available():
