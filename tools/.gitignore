# Python virtual envs (tools/train/.venv and the isolated YOLOX env)
.venv/
.venv-yolox/
__pycache__/

# Generated datasets: raw downloads and merged output are re-creatable
# by tools/train pipeline scripts and are far too large for git.
datasets/

# Training artifacts: keep small text manifests, reports, and logs committed,
# drop large binaries (checkpoints, ONNX). Root .gitignore excludes *.log
# globally; the negation below re-includes deliberately kept logs.
artifacts/*
!artifacts/*.json
!artifacts/*.log

# Eval harness scratch fixture (generated by npm run eval:stub)
eval/.stub-fixture/
